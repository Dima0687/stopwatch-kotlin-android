<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:text="00:00"
        tools:text="00:00"
        android:layout_width="0dp"
        android:layout_height="150dp" android:id="@+id/textView"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0" app:layout_constraintVertical_bias="0.0"
        android:textAlignment="center" android:textSize="34sp" android:gravity="center_horizontal|center_vertical"
        tools:ignore="HardcodedText"/>
    <Button
        android:text="@string/app_btn_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:id="@+id/startButton"
        app:layout_constraintTop_toBottomOf="@+id/textView" app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="56dp" app:layout_constraintEnd_toStartOf="@+id/resetButton"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="455dp" app:layout_constraintVertical_bias="0.438"
        android:layout_marginEnd="128dp"/>
    <Button
        android:text="@string/app_btn_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:id="@+id/resetButton"
        app:layout_constraintStart_toEndOf="@+id/startButton" android:layout_marginEnd="45dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/startButton"
        app:layout_constraintTop_toTopOf="@+id/startButton"/>
    <ProgressBar
        style="?android:attr/progressBarStyle"
        android:layout_width="105dp"
        android:layout_height="105dp"
        android:id="@+id/progressBar"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        android:progressTint="#D90909" app:layout_constraintTop_toBottomOf="@+id/settingsButton"
        app:layout_constraintVertical_bias="0.352"/>
    <Button
        android:text="@string/settings"
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:id="@+id/settingsButton"
        app:layout_constraintTop_toBottomOf="@+id/startButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintHorizontal_bias="1.0"
        android:layout_marginEnd="30dp"
        android:layout_marginStart="30dp" android:layout_marginTop="36dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>